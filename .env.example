# ==============================================================================
# VikasSetu — Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Vite) Configuration
# ------------------------------------------------------------------------------
# Development (Localhost & LAN):
# Use /api to route through the Vite dev server proxy to http://localhost:5000:
VITE_API_URL=/api

# Production (Vercel):
# In Vercel Project Settings -> Environment Variables, configure:
# VITE_API_URL=https://YOUR-DEPLOYED-BACKEND.example.com/api

# ------------------------------------------------------------------------------
# Backend Configuration (stored in backend/.env — NEVER expose in frontend!)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/postgres?pool_timeout=30
# DIRECT_URL=postgresql://user:password@host:5432/postgres
# JWT_SECRET=your-secure-jwt-secret
# PORT=5000
# HOST=0.0.0.0
# NODE_ENV=development
# FRONTEND_URL=https://YOUR-VERCEL-PROJECT.vercel.app
