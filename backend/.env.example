# Copy this file to backend/.env before starting the API.
# The defaults below connect to the local PostgreSQL service in ../docker-compose.yml.
# For Supabase, set DATABASE_URL to the pooler URL and DIRECT_URL to its direct URL.
DATABASE_URL="postgresql://vikassetu:vikassetu_dev_password@localhost:5432/vikassetu?schema=public"
DIRECT_URL="postgresql://vikassetu:vikassetu_dev_password@localhost:5432/vikassetu?schema=public"

JWT_SECRET="replace-this-local-development-secret-before-production"
PORT=5000
NODE_ENV=development

# Career Sahayak chatbot — Gemini 1.5 Flash (RAG-augmented responses)
# Get your key from: https://aistudio.google.com/app/apikey
# If omitted, the chatbot falls back to rule-based responses (no Gemini call).
GEMINI_API_KEY="your-google-ai-studio-api-key-here"

# Python Face AI Microservice (ArcFace buffalo_sc)
# Local development: http://127.0.0.1:8000
# Production on Render: https://sahakar-face-service.onrender.com
FACE_SERVICE_URL="http://127.0.0.1:8000"
FACE_MATCH_THRESHOLD=0.50
